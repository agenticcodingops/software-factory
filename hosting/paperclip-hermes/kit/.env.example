# Copy to .secrets/compose.env on the host; root:root, mode 0600.
# Pass --env-file .secrets/compose.env to every deployment Compose command.
# Reserved example names only. Replace with the host's actual MagicDNS FQDN.
TAILSCALE_HOSTNAME=pilot.tailnet.example
FIXTURE_REPOSITORY=owner/fixture-repository
HERMES_MODEL=gpt-5-mini
# Dedicated dashboard ingress bridge; change both if this subnet is in use.
DASHBOARD_SUBNET=172.30.99.0/24
DASHBOARD_GATEWAY=172.30.99.1

# Generate each independently with openssl rand -hex 32. All must differ.
# Hex also makes POSTGRES_PASSWORD safe in DATABASE_URL without URL escaping.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
PAPERCLIP_AGENT_JWT_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=
PAPERCLIP_SECRETS_MASTER_KEY=
HERMES_GATEWAY_KEY=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# Operator supplies an API project key with an enforced spend limit.
OPENAI_API_KEY=

# Restore adds KIT_MESSAGING_OFF=1, which keeps every Hermes messaging platform
# off at each start; remove that line to turn messaging back on.
