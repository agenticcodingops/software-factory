# Copy to .secrets/compose.env on the host; root:root, mode 0600.
# Pass --env-file .secrets/compose.env to every deployment Compose command.
# Reserved example names only. Replace with the host's actual MagicDNS FQDN.
TAILSCALE_HOSTNAME=pilot.tailnet.example
FIXTURE_REPOSITORY=owner/fixture-repository
HERMES_MODEL=gpt-5-mini
# Dedicated dashboard ingress bridge; change both if this subnet is in use.
DASHBOARD_SUBNET=172.30.99.0/24
DASHBOARD_GATEWAY=172.30.99.1

# Bootstrap generates missing application keys into separate .secrets/ files.
# It also writes KIT_IMAGE_TAG, a fingerprint of the kit commit and code.
# Human secrets arrive through sfctl secret set; never put them in this file.
COMPOSE_PROFILES=paperclip,hermes
