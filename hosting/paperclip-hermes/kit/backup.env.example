# Host-only /etc/paperclip-hermes/backup.env, root 0600, parent 0700.
# Literal unquoted assignments. Never source or export this file.
# Public recipient only; generate and retain the long-term identity off host.
BACKUP_AGE_RECIPIENT=
# HTTPS container user-delegation SAS: sr=c, spr=https, sp=cw (or tested c).
# Require skoid, sktid, skt, ske, sks=b, skv and se; expiry <= 7 days.
# No si, Shared Key, stored policy, service/account SAS, read, list or delete.
BACKUP_CONTAINER_SAS_URL=
